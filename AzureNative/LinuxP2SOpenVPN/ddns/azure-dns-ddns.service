[Unit]
Description=Update the home IPv4 address in Azure public DNS
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=azure-dns-ddns
Group=azure-dns-ddns
ExecStart=/usr/bin/python3 /usr/local/lib/azure-dns-ddns/azure_dns_ddns.py --config /etc/azure-dns-ddns/config.json --state-dir /var/lib/azure-dns-ddns
StateDirectory=azure-dns-ddns
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
